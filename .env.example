# =================================================================
# Open-Source Affiliate Ecosystem Configuration Template
# Copy this file to .env and fill in your private credentials
# =================================================================

# Server Port
PORT=3000

# Production Site URL (without trailing slash)
SITE_URL=https://your-domain.com

# Amazon Associates Tag
AMAZON_ASSOCIATE_TAG=YOUR_ASSOCIATE_TAG_21

# Amazon Influencer Storefront URL (Optional)
AMAZON_STOREFRONT_URL=https://www.amazon.in/shop/YOUR_STOREFRONT_NAME

# Private Admin Portal Passcode
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE

# Safe-Fail Guardian Alert Email
GUARDIAN_ALERT_EMAIL=YOUR_NOTIFICATION_EMAIL@example.com

# Pinterest Developer Integration (Optional)
PINTEREST_APP_ID=YOUR_PINTEREST_APP_ID
PINTEREST_APP_SECRET=YOUR_PINTEREST_APP_SECRET
